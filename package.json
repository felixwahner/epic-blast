{
  "name": "epic-blast",
  "version": "1.0.0",
  "private": true,
  "description": "EPIC BLAST - a Block Blast style puzzle built with Pixi.js and TypeScript, in 16-bit pixel art style.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:build": "vite build && node --test \"tests/build/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:build && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loclacvang123456-alt/Block-blast-clone-10-2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/loclacvang123456-alt/Block-blast-clone-10-2026/issues"
  },
  "homepage": "https://github.com/loclacvang123456-alt/Block-blast-clone-10-2026#readme",
  "dependencies": {
    "pixi.js": "^7.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
